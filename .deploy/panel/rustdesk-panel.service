[Unit]
Description=RustDesk Server Admin Panel
Documentation=https://rustdesk.com/docs/en/self-host/rustdesk-server-oss/
After=network-online.target rustdesk-hbbs.service rustdesk-hbbr.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rustdesk-panel
Environment=RUSTDESK_SERVER_DIR=/var/lib/rustdesk-server
Environment=RUSTDESK_LOG_DIR=/var/log/rustdesk-server
Environment=RUSTDESK_PANEL_CONF=/etc/rustdesk-panel/panel.conf
Environment=RUSTDESK_PANEL_PORT=21120
Environment=RUSTDESK_PANEL_SECRET=__PANEL_SECRET__
ExecStart=/usr/bin/python3 /opt/rustdesk-panel/panel.py
# 面板需要 systemctl 和读密钥目录，所以用 root。
User=root
Restart=always
RestartSec=5
StandardOutput=append:/var/log/rustdesk-server/panel.log
StandardError=append:/var/log/rustdesk-server/panel.error

[Install]
WantedBy=multi-user.target
